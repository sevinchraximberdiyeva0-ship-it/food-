{
  "name": "tezkor-partner-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs && npm --prefix server test",
    "test:frontend": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "build:all": "npm run build && npm --prefix server run build",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "db:generate": "npm --prefix server run db:generate",
    "db:check": "npm --prefix server run db:check",
    "verify:api": "npm --prefix server run verify:api",
    "admin:bootstrap": "npm --prefix server run admin:bootstrap",
    "admin:status": "npm --prefix server run admin:status",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.3",
    "vite": "^6.0.5"
  }
}
