# Backend mode is the default. Demo mode NEVER communicates with the API.
VITE_DEMO_MODE=false
# Leave empty for same-origin /api/v1 (Vite proxies to localhost:3001).
VITE_API_BASE=/api/v1
# Docker Compose only: choose your own password, then match server/.env DATABASE_URL.
POSTGRES_USER=tezkor
POSTGRES_PASSWORD=
POSTGRES_DB=tezkor_demo
