DATABASE_URL=postgresql://tezkor:CHANGE_ME@127.0.0.1:5432/tezkor_demo?schema=public
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
# Seed refuses production and requires an explicitly named demo database.
ALLOW_DEMO_SEED=false
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_EMPLOYEE_EMAIL=employee@example.test
DEMO_COURIER_EMAIL=courier@example.test
DEMO_SECOND_EMAIL=second@example.test
# Set a unique password of at least 12 characters before seeding. No default.
DEMO_PASSWORD=
