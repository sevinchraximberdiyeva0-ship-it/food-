{
  "name": "tezkor-partner-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-postgres.mjs",
    "verify:api": "tsx scripts/verify-live-api.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/bootstrap-admin.ps1",
    "admin:bootstrap": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/bootstrap-admin.ps1",
    "admin:status": "tsx src/createAdmin.ts --check",
    "admin:verify": "tsx scripts/verify-bootstrap-safety.ts"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "overrides": { "@prisma/config": { "effect": "^3.20.0", "deepmerge-ts": "^8.0.0" } },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.7.3"
  }
}
